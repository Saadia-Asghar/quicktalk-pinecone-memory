PINECONE_API_KEY=
PINECONE_INDEX=quicktalk-memories
PINECONE_DIMENSION=384
PORT=8765
SERVICE_API_KEY=
REDIS_URL=
PROFILE_CACHE_TTL=300
WARMUP_ON_STARTUP=true

# Set to mem0 to enable Mem0 OSS + Pinecone infrastructure.
MEMORY_BACKEND=pinecone
OPENAI_API_KEY=
MEM0_PINECONE_INDEX=quicktalk-mem0
MEM0_LLM_MODEL=gpt-4.1-mini
MEM0_EMBEDDING_MODEL=text-embedding-3-small
MEM0_EMBEDDING_DIMENSION=1536
MEM0_HISTORY_DB=data/mem0_history.db
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Fully free local mode: Ollama + embedded Qdrant (no OpenAI/Pinecone keys).
# MEMORY_BACKEND=mem0-local
OLLAMA_BASE_URL=http://localhost:11434
MEM0_LOCAL_LLM_MODEL=llama3.2:1b
MEM0_LOCAL_EMBEDDING_MODEL=nomic-embed-text:latest
MEM0_LOCAL_EMBEDDING_DIMENSION=768
MEM0_LOCAL_INFER=false
MEM0_LOCAL_QDRANT_PATH=data/qdrant
MEM0_LOCAL_HISTORY_DB=data/mem0-local-history.db

# Free-tier Pinecone + local Ollama (no OpenAI key or charges).
# MEMORY_BACKEND=mem0-pinecone-free
MEM0_FREE_PINECONE_INDEX=quicktalk-mem0-free

# Groq LLM (for summarization and memory extraction)
GROQ_API_KEY=your-groq-key-here
# Optional workload isolation. Both fall back to GROQ_API_KEY when omitted.
GROQ_MEMORY_API_KEY=your-groq-memory-key-here
GROQ_KNOWLEDGE_API_KEY=your-groq-knowledge-key-here
GROQ_SUMMARY_API_KEY=your-groq-memory-key-here
AGENT_HISTORY_JSON=/absolute/path/to/agent_chat_history.json
GROQ_SUMMARIZER_ENABLED=true
GROQ_EXTRACTION_MODEL=llama-3.1-8b-instant
MEM0_GROQ_MODEL=llama-3.3-70b-versatile

# Gemini (optional, for summarization)
GEMINI_API_KEY=your-gemini-key-here
GEMINI_SUMMARIZER_ENABLED=false
MEM0_GEMINI_MODEL=gemini-1.5-flash

# Analytics
ANALYTICS_DB_PATH=data/analytics.db
PROFILE_CACHE_TTL=300

# Memory backend options: pinecone | mem0 | mem0-local | mem0-groq | mem0-groq-local | mem0-gemini | mem0-pinecone-free
MEMORY_BACKEND=mem0-groq-local

PINECONE_API_KEY=
PINECONE_INDEX=quicktalk-memories
PINECONE_DIMENSION=384
PORT=8765
SERVICE_API_KEY=

# Set to mem0 to enable Mem0 OSS + Pinecone infrastructure.
MEMORY_BACKEND=pinecone
OPENAI_API_KEY=
MEM0_PINECONE_INDEX=quicktalk-mem0
MEM0_LLM_MODEL=gpt-4.1-mini
MEM0_EMBEDDING_MODEL=text-embedding-3-small
MEM0_EMBEDDING_DIMENSION=1536
MEM0_HISTORY_DB=data/mem0_history.db
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Fully free local mode: Ollama + embedded Qdrant (no OpenAI/Pinecone keys).
# MEMORY_BACKEND=mem0-local
OLLAMA_BASE_URL=http://localhost:11434
MEM0_LOCAL_LLM_MODEL=llama3.2:1b
MEM0_LOCAL_EMBEDDING_MODEL=nomic-embed-text:latest
MEM0_LOCAL_EMBEDDING_DIMENSION=768
MEM0_LOCAL_INFER=false
MEM0_LOCAL_QDRANT_PATH=data/qdrant
MEM0_LOCAL_HISTORY_DB=data/mem0-local-history.db
